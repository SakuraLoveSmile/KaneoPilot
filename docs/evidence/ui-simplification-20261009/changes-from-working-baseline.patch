+        return "自动调度已开启"
+    }
+    private var statusExplanation: String {
+        if stale { return "自动化状态或调度出现问题，请查看错误信息。已有内容可能已过期。" }
+        if scheduler.isSchedulingStopped { return "调度器已停止。请检查错误信息，重新打开应用后再恢复自动处理。" }
