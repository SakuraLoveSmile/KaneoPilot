+                .font(.kpTitle)
+            Text(statusExplanation).font(.kpBody).foregroundStyle(.secondary)
+                .fixedSize(horizontal: false, vertical: true)
+            HStack(spacing: Spacing.m) {
+                Button(model.globalPaused ? "恢复自动推进" : "暂停自动推进") {
